{
  "name": "echodial/deck",
  "description": "A mobile-first CSS framework with no build step, no config file, and no dependencies. Ships the stylesheet, the icon sprite, and a small PHP helper for emitting the tags.",
  "keywords": [
    "css",
    "css-framework",
    "frontend",
    "assets",
    "mobile-first",
    "no-build",
    "keel"
  ],
  "homepage": "https://get-deck.dev",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "EchoDial LLC"
    }
  ],
  "support": {
    "issues": "https://github.com/srivera145/deck/issues",
    "source": "https://github.com/srivera145/deck"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "EchoDial\\Deck\\": "php/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
